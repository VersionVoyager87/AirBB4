@model AirBB.Models.DomainModels.Residence

@{
    ViewData["Title"] = "Add Residence";
}

<h1 class="mb-4">Add Residence</h1>

@if (TempData["validationMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["validationMessage"]
    </div>
}

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<form asp-action="Add" method="post">
    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="LocationId" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select">
                <option value="">Select a location</option>
            </select>
        </div>
        <div class="col-md-6">
            <span asp-validation-for="LocationId" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="Name" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="OwnerId" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="OwnerId" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="OwnerId" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="Accommodation" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="Accommodation" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="Accommodation" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="Bedrooms" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="Bedrooms" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="Bedrooms" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="Bathrooms" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="Bathrooms" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="Bathrooms" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="BuiltYear" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="BuiltYear" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="BuiltYear" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="GuestNumber" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="GuestNumber" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="GuestNumber" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-2">
            <label asp-for="PricePerNight" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="PricePerNight" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="PricePerNight" class="text-danger"></span>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-2">
            <label asp-for="ResidencePicture" class="form-label"></label>
        </div>
        <div class="col-md-4">
            <input asp-for="ResidencePicture" class="form-control" />
        </div>
        <div class="col-md-6">
            <span asp-validation-for="ResidencePicture" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary me-2">Add</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/pastYear.js"></script>
    <script src="~/js/validateBuiltYear.js"></script>
    <script src="~/js/halfStepNumber.js"></script>
}